# Third-party reference implementations. Fetched on demand by
# scripts/fetch_references.py and pinned by version and commit in
# collected/MANIFEST.yaml, so the checkout stays free of vendored
# source while the parity tests stay reproducible. See NOTICE.
collected/*/
